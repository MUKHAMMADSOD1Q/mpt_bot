# ---- Uchta ishchi guruh (odatda o'zgartirish shart emas - allaqachon to'g'ri qiymatlar) ----
ORDERS_GROUP_ID=-1002397917281
PAYMENT_GROUP_ID=-1003180457594
FILES_GROUP_ID=-1004449440402

# ---- AI xizmatlari (ixtiyoriy) ----
